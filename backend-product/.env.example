# Server
PORT=5000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgres://username:password@localhost:5432/subscription_content_db

# Auth
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Shared-secret key for the admin-only "create article" endpoint
ADMIN_KEY=replace_with_a_long_random_admin_key

# Paystack
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx

# Where Paystack sends the user after checkout (your React app)
FRONTEND_URL=http://localhost:3000

# Local folder where article files (PDFs/docx) are stored
FILE_STORAGE_PATH=./uploads
